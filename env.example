# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" (com os valores reais) para o GitHub.

# Gere sua chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_aqui_sua_chave_do_gemini

# Opcional: só mude se quiser testar outro modelo Gemini
# GEMINI_MODEL=gemini-3.5-flash-lite

# Connection string do seu cluster no MongoDB Atlas
# (Atlas > Connect > Drivers > copia a string e troca <password> pela sua senha real)
MONGODB_URI=coloque_aqui_sua_connection_string_do_mongodb

# Chave secreta usada para assinar o cookie de sessão (identidade do usuário).
# Gere uma rodando: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=coloque_aqui_uma_chave_aleatoria_longa
